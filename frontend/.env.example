# Target del proxy /api del servidor de desarrollo de Vite. Es un ORIGEN, sin
# /api/v1. Solo lo usa vite.config.ts; NO llega al bundle.
VITE_API_BASE_URL=http://localhost:8000

# --- solo para el build nativo (Android) ---

# Base COMPLETA de la API, con /api/v1, para el bundle que corre dentro del
# WebView de Capacitor, donde el origen es https://localhost y no hay proxy.
# Vive en .env.native (commiteado, no tiene secretos). En web se deja vacía y
# el cliente usa /api/v1 relativo.
VITE_API_BASE=

# Client ID *Web* del proyecto de Google Cloud — NO el de Android. El ID token
# que devuelve Credential Manager en el teléfono lleva este valor como `aud`, y
# es el que valida POST /api/v1/auth/google/native. El cliente OAuth de Android
# existe solo para que Google autorice este paquete y su firma; no se escribe
# en ningún sitio del código.
# Ponlo en frontend/.env.native.local, que está en .gitignore.
VITE_GOOGLE_WEB_CLIENT_ID=
