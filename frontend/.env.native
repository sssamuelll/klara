VITE_NATIVE=1
VITE_API_BASE=https://klara.sdar.dev/api/v1

# Client ID *Web* del proyecto de Google Cloud, NO el de Android. El ID token que
# Credential Manager devuelve en el teléfono lleva este valor como `aud`, y es el que
# valida POST /api/v1/auth/google/native.
#
# Va versionado a propósito: un client ID de OAuth es público por diseño — viaja en la
# URL de cada pantalla de consentimiento de Google y en el JS de cualquier botón "entrar
# con Google". Lo secreto es el client SECRET, que vive solo en el servidor y no está
# aquí. Sin este valor el APK no puede hacer login con Google.
VITE_GOOGLE_WEB_CLIENT_ID=904183028633-hj7u39q0nu29biit6of05e10g9sps9co.apps.googleusercontent.com
